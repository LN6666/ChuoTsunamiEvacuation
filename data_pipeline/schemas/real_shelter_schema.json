{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/chuo-tsunami-evacuation/real_shelter_schema.json",
  "title": "Phase 3 Real Shelter Export Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "generated_at",
    "source_manifest",
    "coordinate_reference_system",
    "records"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_manifest": {
      "type": "string",
      "minLength": 1
    },
    "coordinate_reference_system": {
      "type": "string",
      "const": "EPSG:4326"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shelterRecord"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableIntegerMinimumZero": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "shelterRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "latitude",
        "longitude",
        "address",
        "capacity",
        "floors_available",
        "elevation_m",
        "source",
        "source_url",
        "source_updated_at",
        "notes",
        "unity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "evacuation_shelter",
            "temporary_shelter",
            "tsunami_evacuation_building",
            "welfare_shelter",
            "unknown"
          ]
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "address": {
          "type": "string"
        },
        "capacity": {
          "$ref": "#/$defs/nullableIntegerMinimumZero"
        },
        "floors_available": {
          "$ref": "#/$defs/nullableIntegerMinimumZero"
        },
        "elevation_m": {
          "$ref": "#/$defs/nullableNumber"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "$ref": "#/$defs/nullableString"
        },
        "source_updated_at": {
          "$ref": "#/$defs/nullableString"
        },
        "notes": {
          "type": "string"
        },
        "unity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prefab_hint",
            "is_entry_enabled",
            "estimated_stair_floors"
          ],
          "properties": {
            "prefab_hint": {
              "type": "string",
              "minLength": 1
            },
            "is_entry_enabled": {
              "type": "boolean"
            },
            "estimated_stair_floors": {
              "$ref": "#/$defs/nullableIntegerMinimumZero"
            }
          }
        }
      }
    }
  }
}
