{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/chuo-tsunami-evacuation/tsunami_hazard_schema.json",
  "title": "Phase 3 Tsunami Hazard Sample Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "generated_at",
    "coordinate_reference_system",
    "source",
    "zones"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "coordinate_reference_system": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/sourceMetadata"
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hazardZone"
      }
    }
  },
  "$defs": {
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "sourceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_family",
        "source_name",
        "organization",
        "official_status",
        "is_official_primary",
        "source_url",
        "source_updated_at",
        "notes"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_family": {
          "type": "string",
          "enum": [
            "tsunami_hazard",
            "paper_or_secondary_reference"
          ]
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "official_status": {
          "type": "string",
          "enum": [
            "official_primary_candidate",
            "official_reference_candidate",
            "secondary_reference_only",
            "synthetic_sample"
          ]
        },
        "is_official_primary": {
          "type": "boolean"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_updated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "hazardZone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone_id",
        "zone_name",
        "hazard_family",
        "affected_zone",
        "hazard_level",
        "geometry_type",
        "geometry",
        "inundation_area",
        "inundation_depth_m",
        "tsunami_height_m",
        "notes"
      ],
      "properties": {
        "zone_id": {
          "type": "string",
          "minLength": 1
        },
        "zone_name": {
          "type": "string",
          "minLength": 1
        },
        "hazard_family": {
          "type": "string",
          "enum": [
            "tsunami",
            "storm_surge",
            "flood",
            "unknown"
          ]
        },
        "affected_zone": {
          "type": "string"
        },
        "hazard_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "geometry_type": {
          "type": "string",
          "enum": [
            "point",
            "polygon",
            "multipolygon",
            "mesh",
            "raster_reference",
            "unknown"
          ]
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "coordinates": {
              "type": "array"
            }
          }
        },
        "inundation_area": {
          "type": "string"
        },
        "inundation_depth_m": {
          "$ref": "#/$defs/nullableNumber"
        },
        "tsunami_height_m": {
          "$ref": "#/$defs/nullableNumber"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
