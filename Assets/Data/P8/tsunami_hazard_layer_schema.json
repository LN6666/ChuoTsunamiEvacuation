{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P8 Tsunami Hazard Layer",
  "type": "object",
  "required": [
    "scenarioId",
    "sourceMode",
    "hazardLayerVersion",
    "timeOriginSeconds",
    "scienceLayerFields",
    "visualLayerFields",
    "features",
    "evidenceSources"
  ],
  "properties": {
    "scenarioId": { "type": "string", "minLength": 1 },
    "sourceMode": { "$ref": "#/$defs/sourceMode" },
    "hazardLayerVersion": { "type": "string", "minLength": 1 },
    "timeOriginSeconds": { "type": "number", "minimum": 0 },
    "scienceLayerFields": {
      "type": "array",
      "items": { "$ref": "#/$defs/scienceFieldName" },
      "minItems": 8,
      "uniqueItems": true
    },
    "visualLayerFields": {
      "type": "array",
      "items": { "$ref": "#/$defs/visualFieldName" },
      "minItems": 2,
      "uniqueItems": true
    },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/hazardFeature" },
      "minItems": 1
    },
    "evidenceSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceSource" },
      "minItems": 1
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "sourceMode": {
      "type": "string",
      "enum": [ "test", "evidence_planned", "manual_sample" ]
    },
    "geometryType": {
      "type": "string",
      "enum": [ "grid", "polygon", "polyline", "point", "synthetic" ]
    },
    "scienceFieldName": {
      "type": "string",
      "enum": [
        "arrivalTimeSeconds",
        "inundationDepthMeters",
        "waterLevelMeters",
        "tsunamiHeightMeters",
        "inundationBoundary",
        "hazardIntensity",
        "confidence",
        "evidenceSourceId",
        "geometryType",
        "sourceMode",
        "boundaryIsEvidenceBasedOrPrototype"
      ]
    },
    "visualFieldName": {
      "type": "string",
      "enum": [
        "visualHeightMeters",
        "visualHeightIsCinematicOnly"
      ]
    },
    "hazardFeature": {
      "type": "object",
      "required": [
        "featureId",
        "sourceMode",
        "geometryType",
        "arrivalTimeSeconds",
        "inundationDepthMeters",
        "waterLevelMeters",
        "tsunamiHeightMeters",
        "inundationBoundary",
        "hazardIntensity",
        "confidence",
        "evidenceSourceId",
        "visualHeightMeters",
        "visualHeightIsCinematicOnly",
        "boundaryIsEvidenceBasedOrPrototype",
        "affectedInfrastructureTypes",
        "buildingDamageState",
        "collapseProxyState",
        "collapseProbability",
        "collapseRandomSeed",
        "hazardDrivenCollapse"
      ],
      "properties": {
        "featureId": { "type": "string", "minLength": 1 },
        "sourceMode": { "$ref": "#/$defs/sourceMode" },
        "geometryType": { "$ref": "#/$defs/geometryType" },
        "arrivalTimeSeconds": { "type": "number", "minimum": 0 },
        "inundationDepthMeters": { "type": "number", "minimum": 0 },
        "waterLevelMeters": { "type": "number" },
        "tsunamiHeightMeters": { "type": "number", "minimum": 0 },
        "inundationBoundary": {
          "type": "array",
          "items": { "$ref": "#/$defs/point2" },
          "minItems": 1
        },
        "hazardIntensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceSourceId": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" },
        "visualHeightMeters": { "type": "number", "minimum": 0 },
        "visualHeightIsCinematicOnly": { "type": "boolean" },
        "boundaryIsEvidenceBasedOrPrototype": {
          "type": "string",
          "enum": [ "evidence_based", "prototype" ]
        },
        "affectedInfrastructureTypes": { "$ref": "#/$defs/affectedInfrastructureTypes" },
        "buildingDamageState": {
          "type": "string",
          "enum": [ "none", "warn", "damaged", "collapse_proxy_candidate" ]
        },
        "collapseProxyState": {
          "type": "string",
          "enum": [ "disabled", "data_only", "candidate" ]
        },
        "collapseProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "collapseRandomSeed": { "type": "integer" },
        "hazardDrivenCollapse": { "type": "boolean" }
      }
    },
    "affectedInfrastructureTypes": {
      "type": "object",
      "required": [
        "roads",
        "buildings",
        "bridges",
        "underground",
        "entrances",
        "waterfront",
        "open_space"
      ],
      "properties": {
        "roads": { "type": "boolean" },
        "buildings": { "type": "boolean" },
        "bridges": { "type": "boolean" },
        "underground": { "type": "boolean" },
        "entrances": { "type": "boolean" },
        "waterfront": { "type": "boolean" },
        "open_space": { "type": "boolean" }
      }
    },
    "point2": {
      "type": "object",
      "required": [ "x", "y" ],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "evidenceSource": {
      "type": "object",
      "required": [
        "evidenceSourceId",
        "sourceMode",
        "sourceCategory",
        "title",
        "reviewedStatus"
      ],
      "properties": {
        "evidenceSourceId": { "type": "string", "minLength": 1 },
        "sourceMode": { "$ref": "#/$defs/sourceMode" },
        "sourceCategory": {
          "type": "string",
          "enum": [
            "official_tsunami_inundation_map",
            "tokyo_chuo_hazard_map",
            "cabinet_office_mlit_local_government",
            "academic_tsunami_simulation_paper",
            "plateau_citygml_category",
            "osm_route_context",
            "manual_sample"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "reviewedStatus": {
          "type": "string",
          "enum": [ "not_attached", "attached_unreviewed", "reviewed_for_planning", "reviewed_for_values" ]
        },
        "notes": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sourceMode": {
            "enum": [ "manual_sample", "evidence_planned" ]
          }
        },
        "required": [ "sourceMode" ]
      },
      "then": {
        "required": [ "evidenceSources" ],
        "properties": {
          "evidenceSources": { "minItems": 1 }
        }
      }
    }
  ],
  "additionalProperties": false
}
