{
  "schemaVersion": "p10c_pre.quality_profiles.v1",
  "projectSettingsChangeRequired": false,
  "packageChangeRequired": false,
  "renderPipelineChangeRequired": false,
  "defaultProfileId": "Low",
  "profiles": [
    {
      "profileId": "Low",
      "targetUse": "ordinary_pc_playability",
      "markerLayerEnabled": true,
      "crowdLayerEnabled": true,
      "lightCurtainEnabled": false,
      "lightCurtainIntensityScale": 0.35,
      "debugLabelsEnabled": false,
      "uiDebugOverlaysEnabled": false,
      "routeProxyDebugVisible": false,
      "candidateMarkerLabelsEnabled": false,
      "collapseDebrisDebugMarkersEnabled": false,
      "maxNpcCount": 40,
      "maxMarkerCount": 90,
      "maxGreenFrameCount": 90,
      "metricsSampleCapacity": 600,
      "memorySampleIntervalSeconds": 1.0,
      "applyTargetFrameRate": true,
      "targetFrameRate": 30,
      "notes": "Conservative ordinary-PC mode. Debug labels and heavy debug overlays stay off; light curtain starts disabled for baseline measurement."
    },
    {
      "profileId": "Medium",
      "targetUse": "default_demonstration_profile",
      "markerLayerEnabled": true,
      "crowdLayerEnabled": true,
      "lightCurtainEnabled": true,
      "lightCurtainIntensityScale": 0.65,
      "debugLabelsEnabled": false,
      "uiDebugOverlaysEnabled": false,
      "routeProxyDebugVisible": false,
      "candidateMarkerLabelsEnabled": false,
      "collapseDebrisDebugMarkersEnabled": false,
      "maxNpcCount": 80,
      "maxMarkerCount": 140,
      "maxGreenFrameCount": 120,
      "metricsSampleCapacity": 900,
      "memorySampleIntervalSeconds": 1.0,
      "applyTargetFrameRate": true,
      "targetFrameRate": 60,
      "notes": "Default demo mode if Low passes. Light curtain is enabled but marker labels remain disabled."
    },
    {
      "profileId": "High",
      "targetUse": "visual_rich_mode_after_gate_passes",
      "markerLayerEnabled": true,
      "crowdLayerEnabled": true,
      "lightCurtainEnabled": true,
      "lightCurtainIntensityScale": 1.0,
      "debugLabelsEnabled": false,
      "uiDebugOverlaysEnabled": false,
      "routeProxyDebugVisible": false,
      "candidateMarkerLabelsEnabled": false,
      "collapseDebrisDebugMarkersEnabled": false,
      "maxNpcCount": 120,
      "maxMarkerCount": 180,
      "maxGreenFrameCount": 140,
      "metricsSampleCapacity": 900,
      "memorySampleIntervalSeconds": 1.0,
      "applyTargetFrameRate": false,
      "targetFrameRate": 60,
      "notes": "Visual-rich inspection mode only after Low/Medium are playable. No ProjectSettings or render-pipeline changes are implied."
    }
  ]
}
